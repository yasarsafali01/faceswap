# =============================================================================
# FaceSwap: tüm yapılandırmanın tek kaynağı.
# `cp .env.example .env` ile kopyalayın, değerleri değiştirin, `docker compose up -d` ile uygulayın.
# Kod içinde port, kullanıcı, limit gibi sabit değer yoktur; hepsi buradan okunur.
# =============================================================================

# ---- Dışarıya açılan portlar (host) -----------------------------------------
# Web arayüzü + API gateway; dışarıya açık tek port.
WEB_PORT=8080
# Aşağıdaki geliştirme/yönetim portlarının açıldığı adres (127.0.0.1 = sadece bu makine).
BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8081
POSTGRES_HOST_PORT=15432
RABBITMQ_UI_HOST_PORT=15672
MINIO_CONSOLE_HOST_PORT=9001
# `npm run dev` ile çalışan geliştirme sunucusu.
DEV_WEB_PORT=5173

# ---- Container içi portlar ----------------------------------------------------
BACKEND_PORT=8080
WORKER_HEALTH_PORT=8000

# ---- PostgreSQL -------------------------------------------------------------------
# Host/port yalnızca harici bir veritabanı kullanılacaksa değişir.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=faceswap
POSTGRES_USER=faceswap
POSTGRES_PASSWORD=change-me

# ---- Redis ------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ ---------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=faceswap
RABBITMQ_PASSWORD=change-me

# ---- Nesne depolama (MinIO / S3 uyumlu) -------------------------------------------
# Harici S3 için endpoint'i (https://...) ve anahtarları değiştirin.
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=faceswap
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=faceswap

# ---- Güvenlik ---------------------------------------------------------------------
# En az 32 byte: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# <video>/<img> için imzalı medya linklerinin ömrü.
MEDIA_LINK_TTL=2h

# ---- Limitler -----------------------------------------------------------------------
MAX_VIDEO_MB=200
MAX_IMAGE_MB=10
# Gateway ve backend'in kabul ettiği en büyük istek; MAX_VIDEO_MB'dan biraz büyük olmalı.
MAX_UPLOAD_MB=210
MAX_DURATION_SECONDS=180
MAX_ACTIVE_JOBS_PER_USER=3
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_HOUR=60
RATE_LIMIT_JOBS_PER_HOUR=30

# ---- GPU worker ---------------------------------------------------------------------
# Videolar bu yüksekliğe küçültülür, fps bu değerle sınırlanır.
MAX_HEIGHT=1080
MAX_FPS=60
# Aynı anda işlenen kare sayısı.
FRAME_WORKERS=3
# libx264 (CPU) veya h264_nvenc (GPU); CRF düşükse kalite yüksek.
VIDEO_ENCODER=libx264
VIDEO_CRF=18
ENHANCER_BLEND=0.8
# Bu yaşın altında tahmin edilen yüzler reddedilir.
MIN_FACE_AGE=18
# Doluysa sağ alta görünür filigran eklenir.
WATERMARK_TEXT=
# Çıktı dosyasının metadata etiketi (görünmez); boşsa yazılmaz.
AI_METADATA_TAG=AI-generated content (FaceSwap)
# Kişi analizi ve eşleştirme (ArcFace benzerlikleri).
CLUSTER_THRESHOLD=0.4
MATCH_THRESHOLD=0.3
KEEP_THRESHOLD=0.15
ANALYSIS_SAMPLES_PER_SECOND=2
ANALYSIS_MAX_SAMPLES=120
# Titreme azaltma.
TEMPORAL_SMOOTHING=true
FLOW_WEIGHT=0.7
ENHANCER_TEMPORAL=0.5
